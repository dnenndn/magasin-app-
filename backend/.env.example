# Copy this file to .env and fill in your real values. Never commit .env.

# Same SQL Server your GMAO desktop app points to (see page_loginn.bas_connextion
# in the decompiled source, or your DBA, for the real values).
DB_SERVER=192.168.1.10
DB_NAME=GMAO
DB_USER=gmao_mobile_readwrite
DB_PASSWORD=change_me
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# Small separate database for the mobile app's own data (pending BSM/BRM
# requests awaiting validation, push tokens, notification log). Create it with
# backend/sql/01_create_app_db.sql. The GMAO database above is not used for any
# of that. All of these are optional - by default the app database is called
# GMAO_APP on the same server and uses the same login as above.
APPDB_NAME=GMAO_APP
# APPDB_SERVER=
# APPDB_PORT=
# APPDB_USER=
# APPDB_PASSWORD=

# Secret used to sign mobile session tokens. Generate a long random string.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Port the connector service listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your mobile app's
# domain, or * only while testing on your own network)
CORS_ORIGIN=*

# Path to the Firebase service account JSON key (for push notifications).
# See BUILD_APK.md "Setting up push notifications" for how to get this file.
# Leave blank to run without push notifications (everything else still works).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
