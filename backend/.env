# Copy this file to .env and fill in your real values. Never commit .env.

# Same SQL Server your GMAO desktop app points to (see page_loginn.bas_connextion
# in the decompiled source, or your DBA, for the real values).
DB_SERVER=localhost
DB_NAME=GMAO_NGES
DB_USER=sa
DB_PASSWORD=hamza1111
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# Secret used to sign mobile session tokens. Generate a long random string.
JWT_SECRET=zfzefzefzfzf
JWT_EXPIRES_IN=12h

# Port the connector service listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your mobile app's
# domain, or * only while testing on your own network)
CORS_ORIGIN=*

FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json